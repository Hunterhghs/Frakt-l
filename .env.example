# DeepSeek API key (required — primary backend)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Optional: Anthropic API key (for Claude models)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: OpenAI API key (for GPT models)
# OPENAI_API_KEY=sk-your-key-here

# Optional: Grok passthrough
# GROK_4_5_API_KEY=your-grok-key-here

# Override config via env
# FRAKTAL_PROVIDER=deepseek
# FRAKTAL_MODEL=deepseek-chat
# FRAKTAL_BASE_URL=https://api.deepseek.com/v1
